generate-web-handbook/node_modules/
.DS_Store
.env
.env.*

# Generated handbook artifacts and intermediate experimental outputs
handbooks/**/screenshots/
handbooks/**/snapshots/
handbooks/**/*.previous-*/
handbooks/**/previous-*/

# 实验原始运行产物（network.har / agent_response.json 等，体积大且可复现，不进 git 历史）
experiments/independent-exploration/
experiments/webarena-handbook-iteration/

# Playwright MCP 浏览器缓存
.playwright-mcp/

# Optional: avoid layering large binary results into Git history
*.png
*.jpg
*.jpeg
*.webp

# 原始 trace 附件完整入库；大体积 JSONL 由 .gitattributes 配置 Git LFS
!platform-core/dev/**/*.png
!platform-core/dev/**/*.jpg
!platform-core/dev/**/*.jpeg
!platform-core/dev/**/*.webp
